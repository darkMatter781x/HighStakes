{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build for Sim",
      "type": "shell",
      "command": "make",
      "args": [
        "VEXIDE_SIMULATION=1",
        "quick",
        "-j",
        "8"
      ],
      "options": {
        "env": {
          "PATH": "${env:PATH}:/home/vscode/.vscode-remote/data/User/globalStorage/sigbots.pros/install/pros-toolchain-linux/bin"
        }
      },
      "group": "build"
    },
    {
      "label": "Run Sim in GDB Mode",
      "type": "shell",
      "command": "echo \"starting simulator in debug mode!\" && simulator monolith ./bin/sim/monolith.bin --gdb",
      "isBackground": true,
      "dependsOn": "Build for Sim",
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "starting simulator in debug mode!"
          }
        }
      ]
    },
    {
      "label": "Build Compile Commands",
      "type": "shell",
      "command": "./scripts/compile_commands.sh",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "./scripts/build-test.sh",
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake template build task"
    }
  ]
}